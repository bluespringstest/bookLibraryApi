{
  "name": "booklibraryapi",
  "version": "1.0.0",
  "description": "An API that allows users to check in and check out books.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "NODE_ENV=test mocha --no-timeouts --inspect --exit --recursive --timeout 10000 --require @babel/register test/**/*.test.js",
    "test:watch": "NODE_ENV=test mocha --no-timeouts --inspect --exit --recursive --timeout 10000 --require @babel/register --watch test/**/*.test.js",
    "test:coverage": "NODE_ENV=test nyc --reporter=text --reporter=lcov mocha --no-timeouts --inspect --exit --recursive --timeout 10000 --require @babel/register test/**/*.test.js",
    "pretest": "node scripts/create-test-db.js",
    "posttest": "node scripts/drop-test-db.js",
    "start": "node src/server.js",
    "dev": "nodemon src/app.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.+(js|json|md|mdx)\"",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluespringstest/bookLibraryApi.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/bluespringstest/bookLibraryApi/issues"
  },
  "homepage": "https://github.com/bluespringstest/bookLibraryApi#readme",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "ejs": "^3.1.10",
    "express": "^4.17.1",
    "express-validator": "^6.14.3",
    "helmet": "^4.6.0",
    "http-status-codes": "^2.2.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.6.7",
    "node-cron": "^4.1.0",
    "nodemailer": "^7.0.3",
    "sequelize": "^6.6.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "winston": "^3.8.2",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@babel/core": "^7.22.10",
    "@babel/preset-env": "^7.22.10",
    "@babel/register": "^7.22.5",
    "chai": "^4.3.7",
    "chai-http": "^4.3.0",
    "eslint": "^8.48.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.0.1",
    "mocha": "^10.2.0",
    "nodemon": "^3.0.1",
    "nyc": "^15.1.0",
    "prettier": "^3.0.3",
    "sequelize-cli": "^6.6.3",
    "sinon": "^15.2.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
